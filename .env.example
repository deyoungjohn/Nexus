# Supply a local/deployment database URL privately, then run npm run db:migrate.
DATABASE_URL=
# Operator-owned reviewed registry/source configuration; never browser supplied.
NEXUS_RECOVERY_CONFIG=config/bsc-recovery.json
# Read-only token-security inspection; trusted review records, never browser supplied.
NEXUS_SECURITY_RPC=https://bsc.rpc.sentio.xyz
NEXUS_TOKEN_SECURITY_REVIEWS=config/token-security-reviews.json
# Must exactly match the browser origin. HTTPS required outside localhost.
NEXUS_APP_ORIGIN=http://localhost:3000
# Optional operator-owned reviewed execution/route JSON. Unset means unavailable.
# Live source ports remain unconfigured; broadcasting defaults disabled.
NEXUS_EXECUTION_CONFIG=
