{
  "name": "nexus",
  "version": "0.0.0",
  "private": true,
  "description": "Coordinated portfolios for tokenized stocks",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "check": "./scripts/check.sh",
    "test": "tsc -p tsconfig.test.json && node dist-test/test/run.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "npm run build && node dist/ledger/migrate-cli.js",
    "recovery:once": "npm run build && node dist/execution/recovery-cli.js",
    "security:tokens": "npm run build && node dist/security/token-security-cli.js",
    "pilot:inspect": "npm run build && node dist/pilot/inspect-cli.js",
    "pilot:declaration": "npm run build && node dist/pilot/records-cli.js",
    "pilot:prices": "npm run build && node dist/pilot/price-monitor-cli.js",
    "pilot:eoa": "npm run build && node dist/pilot/runner-cli.js",
    "demo": "npm run build && node dist/demo.js",
    "attestation": "npm run build && node dist/market-gate/attestation-cli.js",
    "web:dev": "next dev web --webpack",
    "web:build": "next build web --webpack",
    "web:start": "next start web",
    "web:e2e": "playwright test"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-memory": "2026.8.31",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "next": "16.3.7",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
